PORT=8000
DB_USER=admin
DB_HOST=db
DB_NAME=smarthome
DB_PORT=5432
DB_PASSWORD=admin
DB_DBURL=postgresql://admin:admin@db:5432/smarthome

# Đổi thành django.db.backends.postgresql khi có PostgreSQL thật
DB_ENGINE=django.db.backends.sqlite3

SECRET_KEY=django-insecure-s))@g_vfx-(ejoha&n_+=ruin&iqohjxo*3ogc0+seb1=kihpq
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,db

# ==============================================================================
#                      CẤU HÌNH KẾT NỐI VỚI CORE IOT
# ==============================================================================
COREIOT_ENABLED=True
COREIOT_BASE_URL=https://app.coreiot.io

# ----------------- 1. CẤU HÌNH TÀI KHOẢN (Chọn A hoặc B) ----------------------
# (A) Dùng Username/Password của hệ thống CoreIoT
COREIOT_LOGIN_URL=/api/auth/login
COREIOT_EMAIL=doanthuctapbk@gmail.com
COREIOT_PASSWORD=123456

# (B) Dùng trực tiếp tĩnh JWT/Access Token (Bỏ trống email/password nếu dùng cách này)
# QUAN TRỌNG: Chỉ copy nội dung Token, KHÔNG CÓ chữ "Bearer" ở đầu
COREIOT_ACCESS_TOKEN=
COREIOT_AUTH_HEADER=Authorization
COREIOT_AUTH_PREFIX=Bearer
COREIOT_TIMEOUT_SECONDS=10


# ----------------- 2. THÔNG TIN THIẾT BỊ IOT & ĐƯỜNG DẪN ----------------------
# Thiết bị đích trên CoreIoT cần được tương tác.
COREIOT_DEVICE_ID=1c0a36c0-1332-11f1-8b55-69626cc62286

# Phải khai báo hết các khoá ở biến keys=..., ví dụ: brightness,fan_speed,temperature,humidity,light
COREIOT_TELEMETRY_URL_TEMPLATE=/api/plugins/telemetry/DEVICE/{device_id}/values/timeseries?keys=brightness,fan_speed,temperature,humidity,light

# Đường dẫn dùng để gửi tín hiệu điều khiển (rpc) xuống thiết bị. Nhớ chọn twoway/oneway tùy theo logic thiết bị
COREIOT_SETSTATE_URL_TEMPLATE=/api/plugins/rpc/twoway/{device_id}
COREIOT_SETSTATE_MODE=rpc
COREIOT_SETSTATE_METHOD=setState
COREIOT_SETSTATE_VALUE_METHOD=setValue


# ----------------- 3. MAPPING DỮ LIỆU IoT VÀO HỆ THỐNG ------------------------
# Lưu ý: Các biến bắt đầu bằng COREIOT_*_KEY dùng để hứng dữ liệu trả về từ telemetry json 
# của thiết bị IoT. Sửa nếu trên phần cứng đặt key khác.
COREIOT_BRIGHTNESS_KEY=brightness
COREIOT_FAN_SPEED_KEY=fan_speed
COREIOT_TEMPERATURE_KEY=temperature
COREIOT_HUMIDITY_KEY=humidity
COREIOT_LIGHT_KEY=light

# Dưới đây là ID được map ứng với dữ liệu bảng Device dưới Backend Local DB
# Dùng lệnh `python manage.py shell` sau đó gọi query ở database để lấy các ID này
# Ví dụ 6 = Đèn phòng ngủ, 7 = Quạt trần
COREIOT_LOCAL_LIGHT_ACTUATOR_ID=6
COREIOT_LOCAL_FAN_ACTUATOR_ID=4
COREIOT_LOCAL_TEMPERATURE_SENSOR_ID=1
COREIOT_LOCAL_HUMIDITY_SENSOR_ID=2
COREIOT_LOCAL_LIGHT_SENSOR_ID=9

# ----------------- 4. CẤU HÌNH TỐC ĐỘ ĐỒNG BỘ ---------------------------------
# Số giây mỗi lần gọi request API về CoreIoT để update Backend/FE
COREIOT_SYNC_INTERVAL_SECONDS=0.2
# Bỏ qua telemetry actuator nếu timestamp cũ hơn ngưỡng này (tránh auto-off do dữ liệu stale/default 0)
COREIOT_ACTUATOR_STALE_SECONDS=15
# Múi giờ dùng để so khớp lịch (schedule_time)
COREIOT_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
COREIOT_SCHEDULE_LOCAL_FALLBACK=True
COREIOT_AUTO_SYNC_ON_RUNSERVER=True
